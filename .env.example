# The ASP.NET Core backend origin. All browser API calls are proxied through /backend/* (see next.config.ts)
API_ORIGIN=http://localhost:5199

# Exposed to the client for the SignalR hub URL (same origin proxy path)
NEXT_PUBLIC_SIGNALR_PATH=/backend/hubs/fraud-alerts

# Optional
NEXT_PUBLIC_SENTRY_DSN=
