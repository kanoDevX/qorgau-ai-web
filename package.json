    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "openapi-typescript": "^7.5.0",
    "prettier": "^3.4.2",
